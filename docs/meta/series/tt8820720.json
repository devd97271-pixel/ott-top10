humbnail": "https://image.tmdb.org/t/p/w300/fUZSXjXAtlSEimZu9uw5MaVRO5A.jpg"}, {"id": "tt8820720:3:3", "title": "Episode 3", "season": 3, "episode": 3, "released": "2020-04-22T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/8Vnb36QvkZcqyVvlfu1A4oS3Gh9.jpg"}, {"id": "tt8820720:3:4", "title": "Episode 4", "season": 3, "episode": 4, "released": "2020-04-29T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/qFArFQeyaM8mce3AHvVZFAy9321.jpg"}, {"id": "tt8820720:3:5", "title": "Episode 5", "season": 3, "episode": 5, "released": "2020-06-17T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/c4RzXrZDrU4U7cEjorx8y2lmSLy.jpg"}, {"id": "tt8820720:3:6", "title": "Episode 6", "season": 3, "episode": 6, "released": "2020-06-24T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/3pqQ82KmmRGcFpug0TzwsjcWT04.jpg"}, {"id": "tt8820720:3:7", "title": "Episode 7", "season": 3, "episode": 7, "released": "2020-07-01T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/tHpgJrTgkYXEowXzAz6UISp8A8J.jpg"}, {"id": "tt8820720:3:8", "title": "Episode 8", "season": 3, "episode": 8, "released": "2020-07-08T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/9uFRWYlLncxPIkYFAkxPLd6SeF5.jpg"}, {"id": "tt8820720:3:9", "title": "Episode 9", "season": 3, "episode": 9, "released": "2020-07-15T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/z7hSZKOncw2sDobUeFW0wkLqlIJ.jpg"}, {"id": "tt8820720:3:10", "title": "Episode 10", "season": 3, "episode": 10, "released": "2020-07-22T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/p98uGYMRbGAuZWYXrZ3YlU4q8fq.jpg"}, {"id": "tt8820720:4:1", "title": "Gray Suspect", "season": 4, "episode": 1, "released": "2021-04-07T00:00:00.000Z", "overview": "A young woman's stabbed body is found about 10 days after her death in a vacant store in a multi tenant building. The Tokusou team begin investigating, discovering her identity and the fact she promised to meet a man on the day of her death. Meanwhile, the suspect of a murder-robbery case is claiming he saw someone else do the crime.", "thumbnail": "https://image.tmdb.org/t/p/w300/nvntxDDwm1exVZRGRlVAikqPp1u.jpg"}, {"id": "tt8820720:4:2", "title": "Murder Designer", "season": 4, "episode": 2, "released": "2021-04-14T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/6ByCY8geqLohkb8TI0CSi7qv2yf.jpg"}, {"id": "tt8820720:4:3", "title": "Best Day", "season": 4, "episode": 3, "released": "2021-04-21T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/kd0JN3luChfy6Qs56oEjXUAQyRs.jpg"}, {"id": "tt8820720:4:4", "title": "Prayer", "season": 4, "episode": 4, "released": "2021-04-28T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/vgukvpMH4pA6HcdqVdN0iuDVX31.jpg"}, {"id": "tt8820720:4:5", "title": "Killing Blueprint", "season": 4, "episode": 5, "released": "2021-05-05T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/Aw85nIcbn0X9w9EeQiuqs3bA2dM.jpg"}, {"id": "tt8820720:4:6", "title": "Cursed Picture", "season": 4, "episode": 6, "released": "2021-05-12T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/wqfh77nt4ztWaD7ECbrKBtVvq9z.jpg"}, {"id": "tt8820720:4:7", "title": "Murder Puzzle", "season": 4, "episode": 7, "released": "2021-05-19T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/kr4FzMyZ28XgBfH7UFELi7irFUd.jpg"}, {"id": "tt8820720:4:8", "title": "Hedgehog in a Locked Room", "season": 4, "episode": 8, "released": "2021-05-26T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/7d2Uvp8SFgoUSCyppZDZRMysavf.jpg"}, {"id": "tt8820720:4:9", "title": "Flying Suspect", "season": 4, "episode": 9, "released": "2021-06-02T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/1tTvB