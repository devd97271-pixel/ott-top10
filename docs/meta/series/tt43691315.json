{"meta": {"id": "tt43691315", "type": "series", "name": "From Far Away", "poster": "https://image.tmdb.org/t/p/w500/rHI61poyqC6GF0HRurV6Hq12K81.jpg", "background": "https://image.tmdb.org/t/p/w1280/inwM4LXqXYYauU1eJkfJ6uDkV11.jpg", "logo": null, "description": "Noriko is an ordinary high school student, until an explosion pulls her into a world of magic where no one speaks her language. Completely lost, Noriko is rescued by Izark, a shunned swordsman determined to kill the Awakening: a prophesied figure said to control the Sky Demon. As Izark and Noriko bond, he realizes she may be the very person he’s hunting.", "releaseInfo": "2026–", "genres": ["Animation", "Action & Adventure", "Sci-Fi & Fantasy"], "cast": ["Tomoyo Kurosawa", "Kentaro Kumagai", "Yuuichirou Umehara", "Eiji Takeuchi"], "imdbRating": "7.5", "released": "2026-10-05T00:00:00.000Z", "videos": [{"id": "tt43691315:1:1", "title": "The Awakening", "season": 1, "episode": 1, "released": "2026-10-05T00:00:00.000Z", "overview": "Noriko has dreams of another world and one day suddenly disappears from her own.", "thumbnail": "https://image.tmdb.org/t/p/w300/m0bSJx1Xy8BD3lO2DZMLOUM5Pch.jpg"}, {"id": "tt43691315:1:2", "title": "Language Barrier", "season": 1, "episode": 2, "released": "2026-10-12T00:00:00.000Z", "overview": "Noriko decides to follow Izark, but feels frustrated that she can't communicate with anyone.", "thumbnail": "https://image.tmdb.org/t/p/w300/obzHxCKLmy6EBresAEGdvcVRc9K.jpg"}, {"id": "tt43691315:1:3", "title": "Nightmare", "season": 1, "episode": 3, "released": "2026-10-19T00:00:00.000Z", "overview": "Izark falls ill and the bandits who have been terrorizing Calco City take this chance to get revenge.", "thumbnail": "https://image.tmdb.org/t/p/w300/7pequCncrz2uryGV8WcTUAvqOqt.jpg"}, {"id": "tt43691315:1:4", "title": "Formidable Opponent", "season": 1, "episode": 4, "released": "2026-10-26T00:00:00.000Z", "overview": "With the defeat of the bandit leader, the merchant Niva desperately turns to Keimos for protection.", "thumbnail": "https://image.tmdb.org/t/p/w300/hD8MnvzcSii2HE7duTRsebOi3Qo.jpg"}, {"id": "tt43691315:1:5", "title": "Conflict", "season": 1, "episode": 5, "released": "2026-11-02T00:00:00.000Z", "overview": "Noriko can now somewhat communicate with others and Izark decides to leave her with someone he trusts.", "thumbnail": "https://image.tmdb.org/t/p/w300/ino1nxpfZ0hfWWrPt7cB4np1m4U.jpg"}, {"id": "tt43691315:1:6", "title": "Encounter", "season": 1, "episode": 6, "released": "2026-11-09T00:00:00.000Z", "overview": "Noriko meets Agol and his daughter Geena who are suspicious that she may be the Awakening.", "thumbnail": "https://image.tmdb.org/t/p/w300/nhOAmJxJByhcrfsorUR7E7lA2Rc.jpg"}, {"id": "tt43691315:1:7", "title": "Seventeen Against One", "season": 1, "episode": 7, "released": "2026-11-16T00:00:00.000Z", "overview": "Izark will have to face an unfair fight, without knowing whether he will be able to emerge from it unscathed.", "thumbnail": "https://image.tmdb.org/t/p/w300/rCfeQ7q6Kcbqr4Zm0TQCDPvZ994.jpg"}, {"id": "tt43691315:1:8", "title": "White Mist Woods", "season": 1, "episode": 8, "released": "2026-11-23T00:00:00.000Z", "overview": "Noriko and her group enters the White Mist Woods in order to escape Nada's clutches.", "thumbnail": "https://image.tmdb.org/t/p/w300/9CvtHs3g1zxS6J6APgttZVoyJBe.jpg"}, {"id": "tt43691315:1:9", "title": "Episode 9", "season": 1, "episode": 9, "released": "2026-11-30T00:00:00.000Z", "overview": "", "thumbnail": "https://image.tmdb.org/t/p/w300/magainR4Jx6W4m9pNm75CMsVCG8.jpg"}, {"id": "tt43691315:1:10", "title": "Episode 10", "season": 1, "episode": 10, "released": "2026-12-07T00:00:00.000Z", "overview": "", "thumbnail": null}, {"id": "tt43691315:1:11", "title": "Episode 11", "season": 1, "episode": 11, "released": "2026-12-14T00:00:00.000Z", "overview": "", "thumbnail": null}, {"id": "tt43691315:1:12", "title": "Episode 12", "season": 1, "episode": 12, "released": "2026-12-21T00:00:00.000Z", "overview":